{# templates/cliente/novo.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Novo Cliente{% endblock %}
{% block page_title %}Novo Cliente{% endblock %}

{% block body %}
    <div class="pagetitle">
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('home') }}">Home</a></li>
                <li class="breadcrumb-item"><a href="{{ path('cliente_index') }}">Clientes</a></li>
                <li class="breadcrumb-item active">Novo cliente</li>
            </ol>
        </nav>
    </div>

    <section class="section">
        {% include 'cliente/_form.html.twig' with {
            'modo': 'novo',
            'action': path('cliente_novo'),
            'voltar_url': url('cliente_index')
        } only %}
    </section>
{% endblock %}

{% block javascripts %}
    {{ include('cliente/_form_scripts.html.twig') }}
    <script>
        $('.search-bar').addClass('d-none');
        $(function () {
            Utils.formAjax($('#formCliente'), 'Aguarde, enviando dados...');
        });
    </script>
{% endblock %}
