{% extends 'list/_list_base.html.twig' %}

{% block page_title %}Gestão Financeira{% endblock %}
{% block list_title %}Gestão Financeira{% endblock %}
{% block breadcrumbsGrupo %}Financeiro{% endblock %}
{% block breadcrumbsAtivo %}Gestão Financeira{% endblock %}
{% block list_actions %}
    <a href="{{ path('clinica_pdv_index') }}" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-cash-coin me-1"></i>Abrir PDV
    </a>
{% endblock %}

{% block list_stylesheets %}
    
{% endblock %}

{% block list_content %}
{% set abas = [
    {'id': 'diario',     'rotulo': 'Diário',          'icone': 'bi-calendar-event', 'dia': true,  'sep': false},
    {'id': 'clinica',    'rotulo': 'Clínica',         'icone': 'bi-bandaid',        'dia': true,  'sep': false},
    {'id': 'banho_tosa', 'rotulo': 'Banho e tosa',    'icone': 'bi-droplet',        'dia': true,  'sep': false},
    {'id': 'hospedagem', 'rotulo': 'Hospedagem',      'icone': 'bi-house-heart',    'dia': true,  'sep': false},
    {'id': 'fiado',      'rotulo': 'Fiado',           'icone': 'bi-clock-history',  'dia': false, 'sep': true},
    {'id': 'fluxo',      'rotulo': 'Fluxo de caixa',  'icone': 'bi-arrow-left-right', 'dia': false, 'sep': false},
    {'id': 'relatorio',  'rotulo': 'Relatório',       'icone': 'bi-graph-up',       'dia': false, 'sep': false},
    {'id': 'inativos',   'rotulo': 'Inativos',        'icone': 'bi-slash-circle',   'dia': false, 'sep': false}
] %}
{% if aba in ['diario', 'clinica', 'banho_tosa', 'hospedagem'] %}
    {% set parcial = 'caixa' %}
{% else %}
    {% set parcial = aba %}
{% endif %}
<style>
        .fin {
            --fin-ink: #1f2933;
            --fin-muted: #667085;
            --fin-line: #e4e7ec;
            --fin-soft: #f7f8fa;
            --fin-brand: #004080;
            --fin-in: #18794e;
            --fin-out: #b42318;
            --fin-pend: #a15c07;
            color: var(--fin-ink);
        }
        .fin a:focus-visible, .fin button:focus-visible, .fin input:focus-visible {
            outline: 2px solid var(--fin-brand);
            outline-offset: 2px;
        }

        /* Resumo: três números que também são links para a aba correspondente */
        .fin-resumo {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            background: #fff;
            border: 1px solid var(--fin-line);
            border-radius: 8px;
            margin-bottom: 1rem;
            overflow: hidden;
        }
        .fin-kpi {
            display: flex;
            flex-direction: column;
            gap: .15rem;
            padding: 1rem 1.25rem;
            color: inherit;
            text-decoration: none;
            border-right: 1px solid var(--fin-line);
        }
        .fin-kpi:last-child { border-right: 0; }
        .fin-kpi:hover { background: var(--fin-soft); color: inherit; }
        .fin-kpi-label { font-size: .8125rem; color: var(--fin-muted); }
        .fin-kpi-valor {
            font-size: 1.5rem;
            font-weight: 700;
            line-height: 1.2;
            font-variant-numeric: tabular-nums;
        }
        .fin-kpi-nota { font-size: .75rem; color: var(--fin-muted); }

        /* Abas = links */
        .fin-cartao {
            background: #fff;
            border: 1px solid var(--fin-line);
            border-radius: 8px;
            overflow: hidden;
        }
        .fin-tabs {
            display: flex;
            align-items: stretch;
            gap: .25rem;
            padding: 0 .5rem;
            overflow-x: auto;
            border-bottom: 1px solid var(--fin-line);
            background: var(--fin-soft);
        }
        .fin-tab {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            padding: .8rem .9rem;
            margin-bottom: -1px;
            font-size: .9rem;
            font-weight: 600;
            color: var(--fin-muted);
            white-space: nowrap;
            text-decoration: none;
            border-bottom: 2px solid transparent;
        }
        .fin-tab:hover { color: var(--fin-brand); }
        .fin-tab[aria-current="page"] {
            color: var(--fin-brand);
            border-bottom-color: var(--fin-brand);
            background: #fff;
        }
        .fin-tab-sep { width: 1px; margin: .7rem .4rem; background: var(--fin-line); flex: none; }
        .fin-badge {
            min-width: 1.4rem;
            padding: .05rem .45rem;
            font-size: .75rem;
            font-weight: 700;
            text-align: center;
            color: #fff;
            background: var(--fin-pend);
            border-radius: 999px;
        }

        /* Painel */
        .fin-painel { padding: 1.25rem; }
        .fin-cabecalho {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-end;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1rem;
        }
        .fin-titulo { margin: 0; font-size: 1.125rem; font-weight: 700; }
        .fin-sub { margin: .15rem 0 0; font-size: .8125rem; color: var(--fin-muted); }
        .fin-total { text-align: right; }
        .fin-total span { display: block; font-size: .75rem; color: var(--fin-muted); }
        .fin-total strong { font-size: 1.375rem; font-variant-numeric: tabular-nums; }

        .fin-barra {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
            margin-bottom: 1rem;
        }
        .fin-dia, .fin-periodo { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; }
        .fin-dia input[type="date"] { width: auto; }
        .fin-periodo input[type="month"] { width: auto; }
        .fin-busca { max-width: 280px; }

        /* Razão do fluxo de caixa */
        .fin-razao {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            margin-bottom: 1rem;
            border: 1px solid var(--fin-line);
            border-radius: 8px;
        }
        .fin-razao > div { padding: .85rem 1.1rem; border-right: 1px solid var(--fin-line); }
        .fin-razao > div:last-child { border-right: 0; }
        .fin-razao span { display: block; font-size: .8125rem; color: var(--fin-muted); }
        .fin-razao strong { font-size: 1.25rem; font-variant-numeric: tabular-nums; }

        /* Tabela */
        .fin-tabela { width: 100%; margin: 0; font-size: .9rem; }
        .fin-tabela th {
            padding: .6rem .75rem;
            font-size: .8125rem;
            font-weight: 600;
            color: var(--fin-muted);
            white-space: nowrap;
            border-bottom: 1px solid var(--fin-line);
        }
        .fin-tabela td { padding: .7rem .75rem; vertical-align: middle; border-color: var(--fin-line); }
        .fin-tabela tbody tr:hover > * { background: var(--fin-soft); }
        .fin-tabela tfoot td { font-weight: 700; border-top: 2px solid var(--fin-line); border-bottom: 0; }
        .fin-num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
        .fin-acoes { text-align: right; white-space: nowrap; }
        .fin-sec { color: var(--fin-muted); font-size: .8125rem; }
        .fin .fin-in { color: var(--fin-in); }
        .fin .fin-out { color: var(--fin-out); }
        .fin .fin-pend { color: var(--fin-pend); }

        .fin-vazio { padding: 2.5rem 1rem; text-align: center; color: var(--fin-muted); }
        .fin-vazio i { display: block; margin-bottom: .5rem; font-size: 1.75rem; }

        .fin-pag {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
            margin-top: 1rem;
            font-size: .8125rem;
            color: var(--fin-muted);
        }
        .fin-pag-botoes { display: flex; align-items: center; gap: .5rem; }

        @media (max-width: 767.98px) {
            .fin-resumo, .fin-razao { grid-template-columns: 1fr; }
            .fin-kpi, .fin-razao > div { border-right: 0; border-bottom: 1px solid var(--fin-line); }
            .fin-kpi:last-child, .fin-razao > div:last-child { border-bottom: 0; }
            .fin-painel { padding: 1rem; }
            .fin-tabela th, .fin-tabela td { padding: .6rem .5rem; }
            .fin-acoes { white-space: normal; }
            .fin-acoes .btn { padding: .2rem .4rem; margin-bottom: .25rem; }
            .fin-total { text-align: left; }
            .fin-busca { max-width: none; width: 100%; }
        }
    </style>
<div class="col-12 fin">

    <section class="fin-resumo" aria-label="Resumo financeiro">
        <a class="fin-kpi" href="{{ path('financeiro_index', {'aba': 'diario', 'data': data}) }}">
            <span class="fin-kpi-label">Caixa de {{ data|date('d/m/Y') }}</span>
            <strong class="fin-kpi-valor">R$ {{ resumo.caixa_dia|number_format(2, ',', '.') }}</strong>
            <span class="fin-kpi-nota">Vendas pagas no dia</span>
        </a>
        <a class="fin-kpi" href="{{ path('financeiro_index', {'aba': 'fiado'}) }}">
            <span class="fin-kpi-label">Fiado em aberto</span>
            {% if resumo.fiado_total > 0 %}
                <strong class="fin-kpi-valor fin-pend">R$ {{ resumo.fiado_total|number_format(2, ',', '.') }}</strong>
            {% else %}
                <strong class="fin-kpi-valor">R$ 0,00</strong>
            {% endif %}
            <span class="fin-kpi-nota">{{ resumo.fiado_qtd }} lançamento(s) a receber</span>
        </a>
        <a class="fin-kpi" href="{{ path('financeiro_index', {'aba': 'relatorio'}) }}">
            <span class="fin-kpi-label">Mês atual</span>
            <strong class="fin-kpi-valor">R$ {{ resumo.mes|number_format(2, ',', '.') }}</strong>
            <span class="fin-kpi-nota">Total de vendas no mês</span>
        </a>
    </section>

    <div class="fin-cartao">
        <nav class="fin-tabs" aria-label="Seções do financeiro">
            {% for t in abas %}
                {% if t.sep %}<span class="fin-tab-sep" aria-hidden="true"></span>{% endif %}
                {% if t.dia %}
                    {% set rota = path('financeiro_index', {'aba': t.id, 'data': data}) %}
                {% else %}
                    {% set rota = path('financeiro_index', {'aba': t.id}) %}
                {% endif %}
                <a class="fin-tab" href="{{ rota }}"{% if aba == t.id %} aria-current="page"{% endif %}>
                    <i class="bi {{ t.icone }}" aria-hidden="true"></i>{{ t.rotulo }}
                    {% if t.id == 'fiado' and resumo.fiado_qtd > 0 %}
                        <span class="fin-badge">{{ resumo.fiado_qtd }}</span>
                    {% endif %}
                </a>
            {% endfor %}
        </nav>

        <section class="fin-painel">
            {% include 'financeiro/abas/_' ~ parcial ~ '.html.twig' %}
        </section>
    </div>
</div>

{% if aba == 'fiado' %}
<div class="modal fade" id="modalExcluirPendente" tabindex="-1" aria-labelledby="modalExcluirTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="modalExcluirTitulo">Excluir lançamento?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1 fw-semibold" id="pendente-descricao"></p>
                <p class="mb-3 text-muted" id="pendente-valor"></p>
                <p class="mb-0 small">O lançamento será removido do fiado e não poderá ser recuperado.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <form method="post" id="formExcluirPendente" class="d-inline">
                    <button type="submit" class="btn btn-danger">Excluir lançamento</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}

{% block list_javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Busca e paginação da tabela da aba aberta (tudo no navegador, sem recarregar)
            var tabela = document.querySelector('[data-fin-tabela]');
            if (tabela) {
                var linhas = Array.prototype.slice.call(tabela.querySelectorAll('tbody tr[data-busca]'));
                var campo = document.getElementById('fin-busca');
                var contagem = document.getElementById('fin-contagem');
                var rotuloPagina = document.getElementById('fin-pagina');
                var anterior = document.getElementById('fin-ant');
                var proxima = document.getElementById('fin-prox');
                var semResultado = document.getElementById('fin-sem-resultado');
                var porPagina = 15, pagina = 1, visiveis = linhas;

                var normalizar = function (t) {
                    return (t || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
                };

                var desenhar = function () {
                    var total = visiveis.length;
                    var paginas = Math.max(1, Math.ceil(total / porPagina));
                    if (pagina > paginas) { pagina = paginas; }
                    var ini = (pagina - 1) * porPagina;

                    linhas.forEach(function (tr) { tr.hidden = true; });
                    visiveis.slice(ini, ini + porPagina).forEach(function (tr) { tr.hidden = false; });

                    if (semResultado) { semResultado.hidden = total > 0 || linhas.length === 0; }
                    if (contagem) {
                        contagem.textContent = total === 0
                            ? ''
                            : 'Mostrando ' + (ini + 1) + '–' + Math.min(ini + porPagina, total) + ' de ' + total;
                    }
                    if (rotuloPagina) { rotuloPagina.textContent = 'Página ' + pagina + ' de ' + paginas; }
                    if (anterior) { anterior.disabled = pagina <= 1; }
                    if (proxima) { proxima.disabled = pagina >= paginas; }
                };

                if (campo) {
                    campo.addEventListener('input', function () {
                        var termo = normalizar(campo.value.trim());
                        visiveis = linhas.filter(function (tr) {
                            return normalizar(tr.getAttribute('data-busca')).indexOf(termo) !== -1;
                        });
                        pagina = 1;
                        desenhar();
                    });
                }
                if (anterior) { anterior.addEventListener('click', function () { pagina--; desenhar(); }); }
                if (proxima) { proxima.addEventListener('click', function () { pagina++; desenhar(); }); }
                desenhar();
            }

            // Modal de exclusão (aba Fiado)
            var modalEl = document.getElementById('modalExcluirPendente');
            if (modalEl) {
                var modal = new bootstrap.Modal(modalEl);
                document.querySelectorAll('.fin-excluir').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        document.getElementById('pendente-descricao').textContent = btn.dataset.descricao || '';
                        document.getElementById('pendente-valor').textContent = 'Valor: R$ ' + btn.dataset.valor;
                        document.getElementById('formExcluirPendente').action = btn.dataset.acao;
                        modal.show();
                    });
                });
            }
        });
    </script>
{% endblock %}
