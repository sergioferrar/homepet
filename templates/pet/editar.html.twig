{# templates/pet/editar.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Editar Pet{% endblock %}
{% block page_title %}Editar Pet{% endblock %}

{% block body %}
    <div class="pagetitle">
        <nav><ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('home') }}">Home</a></li>
            <li class="breadcrumb-item"><a href="{{ path('pet_index') }}">Pets</a></li>
            <li class="breadcrumb-item active">Editar pet</li>
        </ol></nav>
    </div>
    <section class="row">
        {% include 'pet/_form.html.twig' with {
            'modo': 'editar',
            'action': path('pet_editar', {'id': pet.id}),
            'pet': pet,
            'racas': racas,
            'clientes': clientes,
            'voltar_url': url('pet_index')
        } only %}
    </section>
{% endblock %}

{% block javascripts %}
    {{ include('pet/_form_scripts.html.twig') }}
{% endblock %}
