{# templates/pet/_form_scripts.html.twig — Select2 e idade calculada (requer jQuery) #}
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
$(function () {
    var base = { theme: 'bootstrap-5', width: '100%', allowClear: true, language: { noResults: function () { return 'Nenhum resultado'; } } };
    $('#dono_id').select2($.extend({}, base, { placeholder: 'Selecionar cliente' }));
    // Raça: lista + digitação livre
    $('#raca').select2($.extend({}, base, {
        placeholder: 'Selecionar ou digitar raça...', tags: true,
        createTag: function (p) { var t = $.trim(p.term); return t === '' ? null : { id: t, text: t, newTag: true }; }
    }));

    function idade() {
        var v = $('#data_nascimento').val(), el = $('#idade_calculada');
        if (!v) { el.text(''); return; }
        var n = new Date(v), h = new Date(), a = h.getFullYear() - n.getFullYear(), m = h.getMonth() - n.getMonth();
        if (h.getDate() < n.getDate()) { m--; }
        if (m < 0) { a--; m += 12; }
        var t = (a === 0 && m === 0) ? Math.max(0, Math.floor((h - n) / 864e5)) + ' dia(s)'
              : a === 0 ? m + ' mês(es)' : m === 0 ? a + ' ano(s)' : a + ' ano(s) e ' + m + ' mês(es)';
        el.text('Idade: ' + t);
    }
    $('#data_nascimento').on('change', idade); idade();
});
</script>
