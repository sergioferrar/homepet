{# templates/pet/novo.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Novo Pet{% endblock %}
{% block page_title %}Novo Pet{% endblock %}

{% block body %}
    <div class="pagetitle">
        <nav><ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('home') }}">Home</a></li>
            <li class="breadcrumb-item"><a href="{{ path('pet_index') }}">Pets</a></li>
            <li class="breadcrumb-item active">Novo pet</li>
        </ol></nav>
    </div>
    <section class="section">
        {% include 'pet/_form.html.twig' with {
            'modo': 'novo',
            'action': path('pet_novo'),
            'pet': pet|default({}),
            'racas': racas,
            'clientes': clientes|default([]),
            'cliente_id': cliente_id|default(false),
            'voltar_url': url('pet_index')
        } only %}
    </section>
{% endblock %}

{% block javascripts %}
    {{ include('pet/_form_scripts.html.twig') }}
    <script>
        $(function () { Utils.formAjax($('#formPet'), 'Aguarde, enviando dados...'); });
    </script>
{% endblock %}
