{% extends 'base.html.twig' %}

{% block title %}Nova Consulta{% endblock %}
{% block page_title %}Nova Consulta Veterinária{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .consulta-card { border: 0; border-radius: 12px; }
        .consulta-lista { max-height: 560px; overflow-y: auto; }
        .status-box { transition: background-color .2s ease; }
        .tutor-busca { position: relative; }
        .tutor-resultados {
            position: absolute;
            z-index: 1050;
            width: 100%;
            max-height: 240px;
            overflow-y: auto;
            background: #fff;
            border: 1px solid #dee2e6;
            border-radius: 0 0 8px 8px;
            box-shadow: 0 6px 12px rgba(0, 0, 0, .15);
        }
        .tutor-opcao { cursor: pointer; }
        .tutor-opcao:hover { background: #f0f6ff; }
    </style>
{% endblock %}

{% block body %}
    <div class="pagetitle">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h1>Nova Consulta Veterinária</h1>
            <a href="{{ path('clinica_dashboard') }}" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left me-1"></i>Voltar ao Dashboard
            </a>
        </div>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('home') }}">Home</a></li>
                <li class="breadcrumb-item"><a href="{{ path('clinica_dashboard') }}">Clínica Veterinária</a></li>
                <li class="breadcrumb-item active">Nova Consulta</li>
            </ol>
        </nav>
    </div>

    <section class="section">
        <div class="row g-4">
            <!-- COLUNA ESQUERDA - FORMULÁRIO -->
            <div class="col-lg-8">
                <div class="card consulta-card shadow-sm mb-4">
                    <div class="card-body">
                        <h4 class="mb-4">Marcar Nova Consulta</h4>
                        <form method="post" id="form_consulta">
                            <div class="form-group mb-3 tutor-busca">
                                <label for="tutor_nome" class="form-label">Tutor</label>
                                <input type="text" id="tutor_nome" class="form-control"
                                       placeholder="Digite parte do nome do tutor" autocomplete="off" required>
                                <div id="tutor_resultados" class="tutor-resultados d-none"></div>
                                <input type="hidden" id="cliente_id" name="cliente_id">
                                <div id="tutor_feedback" class="form-text">Digite pelo menos 1 letra e clique no tutor.</div>
                            </div>

                            <div class="form-group mb-3">
                                <label for="pet_id">Pet</label>
                                <select id="pet_id" name="pet_id" class="form-control" required></select>
                            </div>

                            <!-- Atendimento para mais de um pet do mesmo tutor -->
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="toggleMaisPets">
                                <label class="form-check-label" for="toggleMaisPets">
                                    <i class="bi bi-collection me-1"></i>Atendimento para mais de um pet do mesmo tutor
                                </label>
                            </div>

                            <div class="form-group mb-3 d-none" id="blocoPetsAdicionais">
                                <label class="mb-1">Incluir também estes pets no mesmo atendimento:</label>
                                <div id="listaPetsAdicionais" class="border rounded p-2" style="max-height: 160px; overflow-y:auto;">
                                    <small class="text-muted">Selecione um cliente para listar os pets.</small>
                                </div>
                                <small class="text-muted d-block mt-1">
                                    Um único atendimento cobre todos os pets marcados — gerando um pagamento e uma nota fiscal só.
                                </small>
                            </div>

                            <div class="form-group mb-3">
                                <label for="data">Data</label>
                                <input type="date" id="data" name="data" class="form-control" required>
                            </div>

                            <div class="form-group mb-3">
                                <label for="hora">Hora</label>
                                <input type="time" id="hora" name="hora" class="form-control" required>
                            </div>

                            <div class="form-group mb-3">
                                <label for="tipo">Tipo de Atendimento</label>
                                <select class="form-select" id="tipo" name="tipo" required>
                                    <option value="">Selecione o tipo</option>
                                    <option value="Consulta">Atendimento Clínico</option>
                                    <option value="Vacina">Vacina</option>
                                    <option value="Retorno">Retorno</option>
                                    <option value="Emergência">Emergência</option>
                                    <option value="Cirurgia">Cirurgia</option>
                                    <option value="Exame">Exame</option>
                                    <option value="Ultrassom">Ultrassom</option>
                                    <option value="Raio X">Raio X</option>
                                </select>
                            </div>

                            <div class="form-group mb-3">
                                <label for="veterinario_id">Veterinário</label>
                                <select class="form-control" id="veterinario_id" name="veterinario_id">
                                    <option value="">Selecione o veterinário</option>
                                    {% for vet in veterinarios %}
                                        <option value="{{ vet.id }}">{{ vet.nome }}{% if vet.crmv %} - CRMV: {{ vet.crmv }}{% endif %}</option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="form-group mb-3">
                                <label for="observacoes">Observações</label>
                                <textarea id="observacoes" name="observacoes" class="form-control"></textarea>
                            </div>

                            <button class="btn btn-primary">Salvar</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- COLUNA DIREITA - CONSULTAS DE HOJE -->
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="mb-3" style="text-align: center;">Consultas</h5>

                        <form method="get" class="row g-2 mb-3">
                            <div class="col-7">
                                <input type="text" name="pet_nome" class="form-control" placeholder="🔍 Nome do pet"
                                       value="{{ app.request.get('pet_nome') }}">
                            </div>
                            <div class="col-5">
                                <input type="date" name="data" class="form-control"
                                       value="{{ app.request.get('data') }}">
                            </div>
                            <div class="col-12">
                                <button class="btn btn-outline-primary w-100" type="submit">Filtrar</button>
                            </div>
                        </form>

                        {% if consultas is not empty %}
                            <div class="list-group" style="max-height: 400px; overflow-y: auto;">
                                {% for c in consultas %}
                                    <div class="list-group-item mb-3 rounded border status-box
                                    {% if c.status == 'atendido' %}bg-success text-white
                                    {% elseif c.status == 'aguardando' %}bg-warning
                                    {% elseif c.status == 'cancelado' %}bg-danger text-white{% endif %}"
                                         id="consulta-{{ c.id }}">
                                        <div>
                                            <strong>🕒 {{ c.hora|date('H:i') }}</strong><br>
                                            <strong>🐶 Pet:</strong> {{ c.pet_nome }}{% if c.pets_extra is defined and c.pets_extra > 0 %} <span class="badge bg-info text-dark">+{{ c.pets_extra }} pet{{ c.pets_extra > 1 ? 's' : '' }}</span>{% endif %}<br>
                                            <strong>👤 Dono:</strong> {{ c.cliente_nome }}<br>
                                            {% if c.veterinario_nome %}
                                                <strong>👨‍⚕️ Veterinário:</strong> {{ c.veterinario_nome }}<br>
                                            {% endif %}
                                            {% if c.observacoes %}
                                                <strong>📌 Obs:</strong> {{ c.observacoes }}
                                            {% endif %}
                                        </div>
                                        <div class="form-group mt-2">
                                            <select class="form-control form-select"
                                                    onchange="setStatus(this.dataset.id, this.value)"
                                                    data-id="{{ c.id }}">
                                                <option value="aguardando"
                                                        {% if c.status == 'aguardando' %}selected{% endif %}>⏳
                                                    Aguardando
                                                </option>
                                                <option value="atendido"
                                                        {% if c.status == 'atendido' %}selected{% endif %}>✅ Atendido
                                                </option>
                                                <option value="cancelado"
                                                        {% if c.status == 'cancelado' %}selected{% endif %}>❌ Cancelado
                                                </option>
                                            </select>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="text-muted">Nenhuma consulta encontrada.</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const tutorInput = document.getElementById('tutor_nome');
        const clienteInput = document.getElementById('cliente_id');
        const tutorFeedback = document.getElementById('tutor_feedback');
        const tutorResultados = document.getElementById('tutor_resultados');
        const tutores = {{ clientes|map(cliente => {nome: cliente.nome, id: cliente.id, telefone: cliente.telefone|default('')})|json_encode|raw }};
        let petsDoCliente = [];

        tutorInput.addEventListener('input', function () {
            clienteInput.value = '';
            petsDoCliente = [];
            document.getElementById('pet_id').innerHTML = '<option value="">Selecione o tutor primeiro</option>';
            tutorFeedback.textContent = 'Clique em um tutor da lista.';
            tutorFeedback.className = 'form-text';

            const termo = normalizar(this.value);
            if (!termo) {
                tutorResultados.classList.add('d-none');
                return;
            }

            const encontrados = tutores
                .filter(tutor => normalizar(tutor.nome).includes(termo))
                .slice(0, 20);

            tutorResultados.innerHTML = encontrados.length
                ? encontrados.map(tutor => `
                    <button type="button" class="tutor-opcao list-group-item list-group-item-action"
                            data-id="${tutor.id}" data-nome="${escaparHtml(tutor.nome)}">
                        <strong>${escaparHtml(tutor.nome)}</strong>
                        ${tutor.telefone ? `<small class="text-muted d-block">${escaparHtml(tutor.telefone)}</small>` : ''}
                    </button>
                `).join('')
                : '<div class="p-3 text-muted">Nenhum tutor encontrado.</div>';
            tutorResultados.classList.remove('d-none');
        });

        tutorResultados.addEventListener('click', function (event) {
            const opcao = event.target.closest('.tutor-opcao');
            if (!opcao) return;

            clienteInput.value = opcao.dataset.id;
            tutorInput.value = opcao.dataset.nome;
            tutorResultados.classList.add('d-none');
            tutorFeedback.textContent = `Tutor selecionado: ${opcao.dataset.nome}`;
            tutorFeedback.className = 'form-text text-success';
            carregarPets(opcao.dataset.id);
        });

        document.addEventListener('click', function (event) {
            if (!event.target.closest('.tutor-busca')) {
                tutorResultados.classList.add('d-none');
            }
        });

        document.getElementById('form_consulta').addEventListener('submit', function (event) {
            if (!clienteInput.value) {
                event.preventDefault();
                tutorFeedback.textContent = 'Selecione um tutor na lista antes de salvar.';
                tutorFeedback.className = 'form-text text-danger';
                tutorInput.focus();
            }
        });

        function normalizar(valor) {
            return String(valor || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
        }

        function escaparHtml(valor) {
            const div = document.createElement('div');
            div.textContent = valor || '';
            return div.innerHTML;
        }

        function carregarPets(clienteId) {
            const select = document.getElementById('pet_id');
            select.innerHTML = '<option value="">Selecione o pet</option>';
            petsDoCliente = [];

            if (!clienteId) {
                renderPetsAdicionais();
                return;
            }

            const url = '{{ path("clinica_api_pets", {"clienteId": "CLIENTE_ID"}) }}'.replace('CLIENTE_ID', clienteId);

            fetch(url)
                .then(resp => resp.json())
                .then(data => {
                    petsDoCliente = data || [];
                    if (petsDoCliente.length === 0) {
                        select.innerHTML = '<option value="">Nenhum pet encontrado</option>';
                    } else {
                        petsDoCliente.forEach(pet => {
                            const opt = document.createElement('option');
                            opt.value = pet.id;
                            opt.innerText = pet.nome;
                            select.appendChild(opt);
                        });
                    }
                    renderPetsAdicionais();
                })
                .catch(err => console.error(err));
        }

        // Ao trocar o pet principal, remove-o da lista de adicionais
        document.getElementById('pet_id').addEventListener('change', renderPetsAdicionais);

        // Liga/desliga o bloco de pets adicionais
        document.getElementById('toggleMaisPets').addEventListener('change', function () {
            document.getElementById('blocoPetsAdicionais').classList.toggle('d-none', !this.checked);
            renderPetsAdicionais();
        });

        function renderPetsAdicionais() {
            const container = document.getElementById('listaPetsAdicionais');
            const principal = document.getElementById('pet_id').value;
            const ativo = document.getElementById('toggleMaisPets').checked;

            if (!ativo) { return; }

            const outros = petsDoCliente.filter(p => String(p.id) !== String(principal));

            if (outros.length === 0) {
                container.innerHTML = '<small class="text-muted">Este tutor não tem outros pets cadastrados.</small>';
                return;
            }

            container.innerHTML = outros.map(p => `
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="pets_adicionais[]"
                           value="${p.id}" id="petadd_${p.id}">
                    <label class="form-check-label" for="petadd_${p.id}">${p.nome}</label>
                </div>
            `).join('');
        }

        function setStatus(id, status) {
            const url = '{{ path("clinica_consulta_status", {"id": "CONSULTA_ID", "status": "STATUS"}) }}'
                .replace('CONSULTA_ID', id)
                .replace('STATUS', status);

            fetch(url, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
                .then(response => {
                    if (!response.ok) throw new Error('Erro ao atualizar status');
                    return response.json();
                })
                .then(data => {
                    const box = document.getElementById('consulta-' + id);
                    box.classList.remove('bg-success', 'bg-warning', 'bg-danger', 'text-white');

                    switch (status) {
                        case 'atendido':
                            box.classList.add('bg-success', 'text-white');
                            break;
                        case 'aguardando':
                            box.classList.add('bg-warning');
                            break;
                        case 'cancelado':
                            box.classList.add('bg-danger', 'text-white');
                            break;
                    }
                })
                .catch(error => {
                    console.error(error);
                    alert('Erro ao salvar o status.');
                });
        }
    </script>
{% endblock %}
