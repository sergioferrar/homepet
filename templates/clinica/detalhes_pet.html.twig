// ===== Atendimento para mais de um pet do mesmo tutor (ficha) =====
$(document).ready(function () {
    const bloco = document.getElementById('ficha-bloco-pets-adicionais');
    if (!bloco) return;

    const donoId = bloco.dataset.donoId;
    const petAtual = bloco.dataset.petAtual;
    const lista = document.getElementById('ficha-lista-pets-adicionais');
    let carregado = false;

    function carregarPetsDoTutor() {
        if (carregado || !donoId) return;
        carregado = true;

        const url = '{{ path("clinica_api_pets", {"clienteId": "CLIENTE_ID"}) }}'.replace('CLIENTE_ID', donoId);
        fetch(url)
            .then(r => r.json())
            .then(data => {
                const outros = (data || []).filter(p => String(p.id) !== String(petAtual));
                if (outros.length === 0) {
                    lista.innerHTML = '<small class="text-muted">Este tutor não tem outros pets cadastrados.</small>';
                    return;
                }
                lista.innerHTML = outros.map(p => `
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="pets_adicionais[]"
                               value="${p.id}" id="ficha_petadd_${p.id}">
                        <label class="form-check-label" for="ficha_petadd_${p.id}">${p.nome}</label>
                    </div>
                `).join('');
            })
            .catch(() => {
                lista.innerHTML = '<small class="text-danger">Erro ao carregar os pets do tutor.</small>';
                carregado = false;
            });
    }

    document.getElementById('ficha-toggle-mais-pets').addEventListener('change', function () {
        bloco.classList.toggle('d-none', !this.checked);
        if (this.checked) carregarPetsDoTutor();
    });
});
</script>
