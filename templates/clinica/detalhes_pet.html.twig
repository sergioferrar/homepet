// ─────────────────────────────────────────────────────────────────────────────
// LINHAS DE ITEM DA VENDA
//
// Cada linha carrega os SEUS próprios campos, com índice explícito:
//   itens[i][ref]        → "S-12" (serviço) ou "P-7" (produto)
//   itens[i][quantidade] → sempre presente, default 1
//   itens[i][desconto]   → sempre presente, default 0
//
// Com nomes indexados o PHP recebe as três informações já amarradas na mesma
// linha. Não existe mais "casar por posição", que era a origem do bug de a
// quantidade de diárias multiplicar o produto errado.
// ─────────────────────────────────────────────────────────────────────────────

// ── Pets vinculados à venda (itens por pet) ──────────────────────────────────
let petsIncluidosVenda = [];

function escaparHtmlVenda(texto) {
    return String(texto == null ? '' : texto)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

window.opcoesPetsVenda = function (selectedId) {
    return petsIncluidosVenda.map(function (p) {
        const sel = (selectedId && String(selectedId) === String(p.id)) ? ' selected' : '';
        return '<option value="' + p.id + '"' + sel + '>' + escaparHtmlVenda(p.nome) + '</option>';
    }).join('');
};

// ── Checkboxes de pets de UMA linha de item ──────────────────────────────────
// Um mesmo procedimento (coleta de sangue, exame de fezes) costuma ser feito em
// todos os pets que o tutor trouxe. Antes cada linha só aceitava UM pet, então
// o item era cobrado uma vez e o total no PDV saía menor do que o realmente
// executado — era preciso duplicar a linha manualmente. Agora a linha aceita
// vários pets (itens[i][pets][]) e o backend gera um lançamento por pet.
window.checksPetsVenda = function (index, selecionados) {
    const marcados = (Array.isArray(selecionados) && selecionados.length)
        ? selecionados.map(String)
        : [String($('#pets-venda-bloco').data('pet-id'))]; // por padrão, o pet da ficha

    return petsIncluidosVenda.map(function (p) {
        const uid = 'item-' + index + '-pet-' + p.id;
        const checked = marcados.indexOf(String(p.id)) !== -1 ? ' checked' : '';

        return '<div class="form-check form-check-inline me-2">' +
            '<input class="form-check-input check-pet-item" type="checkbox" ' +
            'name="itens[' + index + '][pets][]" value="' + p.id + '" id="' + uid + '"' + checked + '>' +
            '<label class="form-check-label" for="' + uid + '">' + escaparHtmlVenda(p.nome) + '</label>' +
            '</div>';
    }).join('');
};

/** Quantos pets estão marcados nesta linha (0 = nenhum, bloqueia o envio). */
function petsMarcadosNaLinha($linha) {
    const $checks = $linha.find('.check-pet-item');

    // Linha renderizada no formato antigo (select único) → sempre 1 pet
    if (!$checks.length) {
        return 1;
    }

    return $checks.filter(':checked').length;
}

function renderChipsPetsVenda() {
    const $chips = $('#pets-incluidos-chips');
    if (!$chips.length) return;
    const petPrincipal = $('#pets-venda-bloco').data('pet-id');
    $chips.html(petsIncluidosVenda.map(function (p) {
        const removivel = String(p.id) !== String(petPrincipal);
        return '<span class="badge bg-info text-dark">' + p.nome +
            (removivel ? ' <a href="#" class="text-dark remover-pet-venda" data-id="' + p.id + '" style="text-decoration:none;">&times;</a>' : '') +
            '</span>';
    }).join(''));
}

function atualizarSelectsPetItens() {
    // Repopula o dropdown de pet de cada linha mantendo a seleção atual
    $('#servicos-container .select-pet-item').each(function () {
        const atual = $(this).val();
        $(this).html(window.opcoesPetsVenda(atual));
    });

    // Repopula os checkboxes de pet preservando o que já estava marcado.
    // Um pet removido da venda some da lista e, por consequência, do item.
    $('#servicos-container .item-venda-linha').each(function () {
        const $linha = $(this);
        const $grupo = $linha.find('.pets-item-checks');
        if (!$grupo.length) return;

        const marcados = $grupo.find('.check-pet-item:checked')
            .map(function () { return $(this).val(); }).get();

        $grupo.html(window.checksPetsVenda($linha.attr('data-index'), marcados));
        recalcularLinha($linha);
    });
}

$(document).ready(function () {
    const $bloco = $('#pets-venda-bloco');
    if ($bloco.length) {
        // Pet principal da ficha já entra incluído
        petsIncluidosVenda = [{ id: String($bloco.data('pet-id')), nome: $bloco.data('pet-nome') }];
        renderChipsPetsVenda();

        // Carrega os outros pets do tutor para o select "incluir pet"
        const donoId = $bloco.data('dono-id');
        if (donoId) {
            $.ajax({
                url: '{{ path("clinica_pets_by_tutor", {"id": "ID_PLACEHOLDER"}) }}'.replace('ID_PLACEHOLDER', donoId),
                method: 'GET'
            }).done(function (pets) {
                const petPrincipal = String($bloco.data('pet-id'));
                (pets || []).forEach(function (p) {
                    if (String(p.id) !== petPrincipal) {
                        $('#pet-adicionar-select').append($('<option>').val(p.id).text(p.nome));
                    }
                });
            });
        }
    }

    $('#btn-adicionar-pet-venda').on('click', function () {
        const $sel = $('#pet-adicionar-select');
        const id = $sel.val();
        if (!id) return;
        const nome = $sel.find('option:selected').text();
        if (!petsIncluidosVenda.find(function (p) { return String(p.id) === String(id); })) {
            petsIncluidosVenda.push({ id: String(id), nome: nome });
            renderChipsPetsVenda();
            atualizarSelectsPetItens();
        }
        $sel.find('option:selected').remove();
        $sel.val('');
    });

    $(document).on('click', '.remover-pet-venda', function (e) {
        e.preventDefault();
        const id = String($(this).data('id'));
        petsIncluidosVenda = petsIncluidosVenda.filter(function (p) { return String(p.id) !== id; });
        // Devolve o pet ao select de inclusão
        $('#pet-adicionar-select').append($('<option>').val(id).text($(this).parent().text().replace('×', '').trim()));
        renderChipsPetsVenda();
        atualizarSelectsPetItens();
    });
});

function montarLinhaItem(index) {
    return `
<div class="item-venda-linha" data-index="${index}">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="fw-bold text-muted" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;">
            Item <span class="numero-linha">${index + 1}</span>
        </span>
        <button type="button" class="btn btn-sm btn-outline-danger remove-servico" title="Remover item">
            <i class="bi bi-trash"></i>
        </button>
    </div>
    <div class="row g-2">
        <div class="col-12 mb-2">
            <label class="form-label">Serviço / Produto*</label>
            <select class="form-select select-servico" name="itens[${index}][ref]" required>
                <option value="">Selecione...</option>
                {% for servico in servicos_clinica %}
                    <option value="S-{{ servico.id }}" data-valor="{{ servico.valor|number_format(2, '.', '') }}">
                        {{ servico.nome }} - R$ {{ servico.valor|number_format(2, ',', '.') }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="col-12 mb-2 col-pet-item">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <label class="form-label mb-1">Pets que receberam este item*</label>
                <div class="mb-1">
                    <button type="button" class="btn btn-link btn-sm p-0 marcar-todos-pets">Marcar todos</button>
                    <span class="text-muted mx-1">·</span>
                    <button type="button" class="btn btn-link btn-sm p-0 desmarcar-todos-pets">Só o principal</button>
                </div>
            </div>
            <div class="pets-item-checks d-flex flex-wrap">
                ${window.checksPetsVenda ? window.checksPetsVenda(index) : ''}
            </div>
            <small class="text-muted ajuda-pets"></small>
        </div>
        <div class="col-6">
            <label class="form-label label-quantidade">Quantidade</label>
            <input type="number" class="form-control qtd-item" name="itens[${index}][quantidade]" min="1" step="1" value="1">
            <small class="text-muted ajuda-quantidade"></small>
        </div>
        <div class="col-6">
            <label class="form-label">Desconto (R$) <span class="text-muted">por pet</span></label>
            <input type="number" class="form-control desconto-item" name="itens[${index}][desconto]" step="0.01" min="0" value="0">
        </div>
    </div>
    <div class="text-end mt-2 linha-subtotal">Subtotal: R$ 0,00</div>
</div>`;
}

// Reindexa os names após remover uma linha do meio.
// Sem isso, remover o item 2 de 3 deixava índices repetidos/furados.
function reindexarLinhas() {
    $('#servicos-container .item-venda-linha').each(function(i) {
        $(this).attr('data-index', i);
        $(this).find('.numero-linha').text(i + 1);
        $(this).find('.select-servico').attr('name', `itens[${i}][ref]`);
        $(this).find('.qtd-item').attr('name', `itens[${i}][quantidade]`);
        $(this).find('.desconto-item').attr('name', `itens[${i}][desconto]`);
        $(this).find('.select-pet-item').attr('name', `itens[${i}][pet_id]`);

        // Os checkboxes de pet também carregam o índice — sem reindexar, remover
        // uma linha do meio faria dois itens dividirem o mesmo índice e o PHP
        // sobrescreveria a lista de pets de um deles.
        $(this).find('.check-pet-item').each(function () {
            const uid = `item-${i}-pet-${$(this).val()}`;
            $(this).attr('name', `itens[${i}][pets][]`).attr('id', uid);
            $(this).next('label').attr('for', uid);
        });
    });
}

function recalcularLinha($linha) {
    if (!$linha || !$linha.length) return;

    const $select = $linha.find('.select-servico');
    const valorUnit = parseFloat($select.find('option:selected').data('valor')) || 0;
    const qtd = Math.max(1, parseInt($linha.find('.qtd-item').val(), 10) || 1);
    const pets = petsMarcadosNaLinha($linha);

    // Valor de um pet: quantidade × unitário. O desconto é POR PET, porque o
    // backend replica a linha para cada pet marcado (um venda_item por pet).
    const brutoPorPet = valorUnit * qtd;

    let desconto = parseFloat($linha.find('.desconto-item').val()) || 0;
    if (desconto < 0) desconto = 0;
    if (desconto > brutoPorPet) {
        desconto = brutoPorPet;
        $linha.find('.desconto-item').val(desconto.toFixed(2));
    }

    const subtotal = Math.max(0, (brutoPorPet - desconto) * pets);

    if (pets === 0) {
        $linha.find('.linha-subtotal').html('<span class="text-danger">Marque ao menos um pet para este item</span>');
        $linha.find('.ajuda-pets').text('');
    } else {
        let detalhe = '';
        if (qtd > 1 || pets > 1) {
            detalhe = ` (${qtd} × R$ ${valorUnit.toFixed(2).replace('.', ',')}` +
                (pets > 1 ? ` × ${pets} pets` : '') + ')';
        }
        $linha.find('.linha-subtotal').text(`Subtotal: R$ ${subtotal.toFixed(2).replace('.', ',')}${detalhe}`);
        $linha.find('.ajuda-pets').text(
            pets > 1 ? `Este item será lançado ${pets} vezes — uma para cada pet marcado.` : ''
        );
    }

    calcularTotal();
    return subtotal;
}

function calcularTotal() {
    let total = 0;

    $('#servicos-container .item-venda-linha').each(function() {
        const $linha = $(this);
        const $select = $linha.find('.select-servico');
        if (!$select.val()) return;

        const valorUnit = parseFloat($select.find('option:selected').data('valor')) || 0;
        const qtd = Math.max(1, parseInt($linha.find('.qtd-item').val(), 10) || 1);
        const pets = petsMarcadosNaLinha($linha);
        const brutoPorPet = valorUnit * qtd;

        let desconto = parseFloat($linha.find('.desconto-item').val()) || 0;
        if (desconto < 0) desconto = 0;
        if (desconto > brutoPorPet) desconto = brutoPorPet;

        // × pets: o mesmo procedimento feito em 2 animais custa 2 vezes
        total += Math.max(0, (brutoPorPet - desconto) * pets);
    });

    $('#total-servicos').text(total.toFixed(2).replace('.', ','));
    return total;
}

function adicionarLinhaItem() {
    const index = $('#servicos-container .item-venda-linha').length;
    $('#servicos-container').append(montarLinhaItem(index));

    const $novoSelect = $(`#servicos-container .item-venda-linha[data-index="${index}"] .select-servico`);
    if ($novoSelect.data('select2')) {
        $novoSelect.select2('destroy');
    }
    $novoSelect.select2({
        dropdownParent: $('#modalAdicionarServico .modal-content'),
        placeholder: "Selecione ou pesquise um serviço...",
        allowClear: true,
        width: '100%'
    });

    calcularTotal();
    return $novoSelect;
}

$(document).on("click", ".add-servico", function() {
    adicionarLinhaItem();
});

$(document).on("click", ".remove-servico", function() {
    const $container = $('#servicos-container');
    $(this).closest(".item-venda-linha").remove();

    // Nunca deixa o formulário sem nenhuma linha
    if ($container.find('.item-venda-linha').length === 0) {
        adicionarLinhaItem();
    } else {
        reindexarLinhas();
    }

    calcularTotal();
});
$('#modalAdicionarServico').on('shown.bs.modal', function() {
    if ($('#servicos-container .item-venda-linha').length === 0) {
        adicionarLinhaItem();
    }
    calcularTotal();
});
