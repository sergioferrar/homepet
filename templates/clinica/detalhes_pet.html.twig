    let _atendimentoEmAndamento = false;
    $('#form-atendimento').on('submit', function(e) {
        e.preventDefault();
        if (_atendimentoEmAndamento) return;

        // Sincroniza o conteúdo do editor Quill no input hidden antes de montar o FormData
        if (quillAtendimento) {
            $('#anamnese-input').val(JSON.stringify(quillAtendimento.getContents()));
        }

        _atendimentoEmAndamento = true;
        const $btnSubmit = $(this).find('button[type="submit"]');
        $btnSubmit.prop('disabled', true).html('<i class="bi bi-hourglass-split"></i> Salvando...');

        fetch(this.action, {
            method: 'POST',
            body: new FormData(this),
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(async r => {
            // Lê a resposta como texto e tenta interpretar como JSON.
            // Se o servidor devolver HTML (ex.: página de erro 500), extrai uma
            // mensagem útil em vez do genérico "Falha de comunicação".
            const texto = await r.text();
            let data;
            try {
                data = JSON.parse(texto);
            } catch (e) {
                throw new Error(
                    'O servidor não retornou uma resposta válida (HTTP ' + r.status + '). ' +
                    (texto ? texto.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 200) : '')
                );
            }
            if (!r.ok && !(data && data.mensagem)) {
                throw new Error('Erro no servidor (HTTP ' + r.status + ').');
            }
            return data;
        })
        .then(data => {
            if (data.status === 'success') {
                if (window.Notify && Notify.toast) {
                    Notify.toast(data.mensagem, 'success');
                }
                setTimeout(() => { window.location.href = data.redirect || window.location.href; }, 600);
            } else {
                _atendimentoEmAndamento = false;
                $btnSubmit.prop('disabled', false).html('<i class="fas fa-save me-1"></i>Salvar Atendimento');
                const msg = data.mensagem || 'Erro ao salvar o atendimento.';
                if (window.Notify && Notify.toast) {
                    Notify.toast(msg, 'danger');
                } else {
                    alert(msg);
                }
            }
        })
        .catch((err) => {
            _atendimentoEmAndamento = false;
            $btnSubmit.prop('disabled', false).html('<i class="fas fa-save me-1"></i>Salvar Atendimento');
            const msg = (err && err.message) ? err.message : 'Falha de comunicação com o servidor.';
            if (window.Notify && Notify.toast) {
                Notify.toast(msg, 'danger');
            } else {
                alert(msg);
            }
        });
    });

