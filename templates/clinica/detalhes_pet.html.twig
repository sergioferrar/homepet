    function pdvIframeOnLoad() {
        var iframe = document.getElementById('pdvIframe');
        if (!iframe || iframe.src === 'about:blank') return;

        // Tenta injetar o payload assim que o iframe carregar
        try {
            var iframeWin = iframe.contentWindow;
            // Espera o PDV estar pronto (evento customizado ou polling)
            var tentativas = 0;
            var intervalo = setInterval(function() {
                tentativas++;
                try {
                    if (iframeWin.pdvReceberVendaClinica) {
                        clearInterval(intervalo);
                        iframeWin.pdvReceberVendaClinica(_pdvVendaCarregada);
                        document.getElementById('pdvLoadingOverlay').style.display = 'none';
                    }
                } catch (e) {
                    /* cross-origin ainda não pronto */ }
                if (tentativas > 40) {
                    clearInterval(intervalo);
                    document.getElementById('pdvLoadingOverlay').style.display = 'none';
                }
            }, 250);
        } catch (e) {
            document.getElementById('pdvLoadingOverlay').style.display = 'none';
        }
    }

