{% extends 'base.html.twig' %}
{% block title %}Painel de Controle{% endblock %}
{% block page_title %}Dashboard - Clínica Veterinária{% endblock %}
{% block body %}
    <style>
    .dash{--d-surface:var(--hp-surface,#fff);--d-soft:var(--hp-soft,#eef3f6);--d-line:var(--hp-line,#e4e9ed);--d-brand:var(--hp-brand,#0e6e8c)}
    .dash .hero{background:linear-gradient(135deg,#0e6e8c,#14b8a6);color:#fff;border-radius:16px}
    .dash .hero .form-control{border:0;border-radius:10px 0 0 10px}
    .dash .hero .btn-search{border-radius:0 10px 10px 0;background:#fff;color:#0e6e8c;border:0}
    .dash .hero .btn-act{background:rgba(255,255,255,.16);color:#fff;border:1px solid rgba(255,255,255,.35);border-radius:10px}
    .dash .hero .btn-act:hover{background:rgba(255,255,255,.28);color:#fff}
    .dash .panel{background:var(--d-surface);border:1px solid var(--d-line);border-radius:14px;overflow:hidden}
    .dash .panel-h{display:flex;align-items:center;gap:.6rem;padding:.8rem 1rem;border-bottom:1px solid var(--d-line)}
    .dash .panel-h h2{font-size:.95rem;font-weight:600;margin:0}
    .dash .panel-h .ms-auto{font-size:.75rem}
    .dash .scroll{max-height:330px;overflow-y:auto}
    .dash .row-item{display:flex;align-items:center;gap:.75rem;padding:.65rem 1rem;border-bottom:1px solid var(--d-line)}
    .dash .row-item:last-child{border-bottom:0}
    .dash .row-item:hover{background:var(--d-soft)}
    .dash .ico{width:36px;height:36px;border-radius:10px;display:grid;place-items:center;background:var(--d-soft);color:var(--d-brand);flex-shrink:0}
    .dash .nome{font-weight:600;color:inherit;text-decoration:none;display:block;line-height:1.2}
    .dash .nome:hover{color:var(--d-brand)}
    .dash .kpi .n{font-size:1.65rem;font-weight:700;line-height:1.1}
    .dash .empty{padding:2rem 1rem;text-align:center;color:var(--bs-secondary-color,#6c757d)}
    .dash .empty i{font-size:1.8rem;display:block;margin-bottom:.35rem;opacity:.6}
    .dash .nav-pills .nav-link{padding:.3rem .75rem;font-size:.85rem}
    @media(max-width:575.98px){.dash .scroll{max-height:none}}
    </style>
    <div class="dash">
        {% set hora = "now"|date("G") %}
        {# ===== 1. Cabeçalho: saudação, busca e ações — o essencial fica sempre no topo ===== #}
        <section class="hero p-3 p-md-4 mb-3">
            <div class="row g-3 align-items-center">
                <div class="col-lg-5">
                    <h1 class="h4 fw-bold mb-1">{{ hora < 12 ? 'Bom dia' : (hora < 18 ? 'Boa tarde' : 'Boa noite') }}!</h1>
                    <p class="mb-0 opacity-75 small">
                        <i class="bi bi-calendar3 me-1"></i>{{ "now"|date("d/m/Y") }} · {{ "now"|date("H:i") }} · Clínica veterinária</p>
                </div>
                <div class="col-lg-7">
                    <form method="get" action="{{ path('clinica_dashboard') }}" class="input-group mb-2" role="search">
                        <input type="search" name="q" value="{{ termo }}" class="form-control form-control-lg" placeholder="Buscar pet ou tutor..." aria-label="Buscar pet ou tutor">
                        <button type="submit" class="btn btn-search px-4" aria-label="Buscar">
                        <i class="bi bi-search"></i>
                        </button>
                    </form>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-act btn-sm" href="{{ url('orcamento_novo') }}">
                            <i class="bi bi-file-earmark-plus me-1"></i>Novo orçamento</a>
                        <a class="btn btn-act btn-sm" href="{{ path('orcamento_index') }}">
                            <i class="bi bi-receipt me-1"></i>Orçamentos</a>
                        <button class="btn btn-act btn-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasPrescricoes">
                        <i class="bi bi-capsule-pill me-1"></i>Prescrições</button>
                        {% if pode_ver_financeiro() %}<a class="btn btn-act btn-sm" href="{{ path('clinica_relatorio_como_conheceu') }}">
                            <i class="bi bi-bar-chart-line me-1"></i>Como conheceram</a>{% endif %}
                    </div>
                </div>
            </div>
        </section>
        {# ===== Resultado da busca (só aparece quando há termo) ===== #}
        {% if termo %}
            <section class="panel mb-3" aria-label="Resultados da busca">
                <div class="panel-h">
                    <i class="bi bi-funnel text-primary"></i>
                    <h2>Resultados para "{{ termo }}"</h2>
                    <span class="ms-auto badge text-bg-secondary">{{ pets|length }}</span>
                </div>
                <div class="row g-0">
                    {% for pet in pets %}
                        <div class="col-md-6 col-xl-4">
                            <div class="row-item h-100">
                                <span class="ico">
                                    <i class="bi bi-postcard-heart"></i>
                                </span>
                                <div class="min-w-0">
                                    <a class="nome consulta stretched-link" href="{{ path('clinica_detalhes_pet', {'id': pet.id}) }}">{{ pet.nome }}</a>
                                    <small class="text-secondary">
                                    <i class="bi bi-person me-1"></i>{{ pet.dono_nome }} · {{ pet.especie }}{{ pet.raca ? ' · ' ~ pet.raca : '' }}</small>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="col-12 empty">
                            <i class="bi bi-search"></i>Nenhum resultado para "{{ termo }}".</div>
                    {% endfor %}
                </div>
            </section>
        {% endif %}
        {# ===== 2. Números do dia (4 indicadores) ===== #}
        <section class="row row-cols-2 row-cols-xl-4 g-3 mb-3" aria-label="Indicadores">
            <div class="col">
                <div class="panel kpi p-3 d-flex gap-3 align-items-center">
                    <span class="ico">
                        <i class="bi bi-postcard-heart"></i>
                    </span>
                    <div>
                        <div class="n">{{ total_pets }}</div>
                        <small class="text-secondary">Animais registrados</small>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="panel kpi p-3 d-flex gap-3 align-items-center">
                    <span class="ico">
                        <i class="bi bi-people"></i>
                    </span>
                    <div>
                        <div class="n">{{ totaldono }}</div>
                        <small class="text-secondary">Clientes cadastrados</small>
                    </div>
                </div>
            </div>
            {% if pode_ver_financeiro() %}
                <div class="col">
                    <div class="panel kpi p-3 d-flex gap-3 align-items-center">
                        <span class="ico text-danger">
                            <i class="bi bi-cash-stack"></i>
                        </span>
                        <div>
                            <div class="n text-danger">R$ {{ debitos_cliente|number_format(2, ',', '.') }}</div>
                            <small class="text-secondary">Débitos em aberto</small>
                        </div>
                    </div>
                </div>
            {% endif %}
            <div class="col">
                <div class="panel kpi p-3 d-flex gap-3 align-items-center">
                    <span class="ico text-warning">
                        <i class="bi bi-stopwatch"></i>
                    </span>
                    <div>
                        <div class="n">{{ media_atendimento }}</div>
                        <small class="text-secondary">Média de atendimento</small>
                    </div>
                </div>
            </div>
        </section>
        {# ===== 3. Operação: o que exige atenção (esquerda) e o que acompanhar (direita) ===== #}
        <div class="row g-3">
            <div class="col-xl-7">
                <div class="d-flex flex-column gap-3">
                    <section class="panel" aria-label="Animais internados">
                        <div class="panel-h">
                            <i class="bi bi-hospital text-danger"></i>
                            <h2>Animais internados</h2>
                            <span class="ms-auto badge text-bg-danger">{{ internados|length }}</span>
                        </div>
                        <div class="scroll">
                            {% for internacao in internados %}
                                {% set petId   = attribute(internacao, 'pet_id')|default(attribute(internacao, 'id')) %}
                                {% set petNome = attribute(internacao, 'pet_nome')|default(attribute(internacao, 'nome_pet')|default('Pet')) %}
                                {% set dono    = attribute(internacao, 'dono_nome')|default('') %}
                                {% set motivo  = attribute(internacao, 'motivo')|default('') %}
                                <div class="row-item">
                                    <span class="ico text-danger">
                                        <i class="bi bi-heart-pulse-fill"></i>
                                    </span>
                                    <div class="me-auto min-w-0">
                                        {% if petId is defined and petId is not null and petId > 0 %}<a class="nome consulta" href="{{ path('clinica_detalhes_pet', {'id': petId}) }}">{{ petNome }}</a>{% else %}<span class="nome">{{ petNome }}</span>{% endif %}
                                        <small class="text-secondary">{{ dono }}</small>
                                    </div>
                                    <span class="badge {{ 'Emergencia' in motivo ? 'text-bg-danger' : 'text-bg-warning' }}">{{ 'Emergencia' in motivo ? 'Emergência' : 'Pouco urgente' }}</span>
                                </div>
                            {% else %}
                                <div class="empty">
                                    <i class="bi bi-check-circle text-success"></i>Nenhuma internação ativa.</div>
                            {% endfor %}
                        </div>
                    </section>
                    <section class="panel" aria-label="Últimos atendimentos">
                        <div class="panel-h">
                            <i class="bi bi-clipboard2-pulse text-success"></i>
                            <h2>Últimos atendimentos (24h)</h2>
                            <span class="ms-auto badge text-bg-secondary">{{ atendimentos|length }}</span>
                        </div>
                        <div class="scroll">
                            {% for item in atendimentos %}
                                {% set petId       = attribute(item, 'pet_id')|default(attribute(item, 'id')) %}
                                {% set petNome     = attribute(item, 'nome_pet')|default(attribute(item, 'pet')|default('Pet')) %}
                                {% set clienteNome = attribute(item, 'nome_cliente')|default(attribute(item, 'cliente')|default('')) %}
                                {% set dataAt      = attribute(item, 'data_inicio')|default(attribute(item, 'data')) %}
                                <div class="row-item">
                                    <span class="ico text-success">
                                        <i class="bi bi-clipboard2-pulse"></i>
                                    </span>
                                    <div class="me-auto min-w-0">
                                        <a class="nome consulta" href="{{ path('clinica_detalhes_pet', {'id': petId}) }}">{{ petNome }}</a>
                                        <small class="text-secondary">{{ clienteNome }}</small>
                                    </div>
                                    <span class="badge text-bg-primary">{{ dataAt|date('d/m') }} {{ item.hora|date('H:i') }}</span>
                                </div>
                            {% else %}
                                <div class="empty">
                                    <i class="bi bi-inbox"></i>Nenhum atendimento recente.</div>
                            {% endfor %}
                        </div>
                    </section>
                </div>
            </div>
            <div class="col-xl-5">
                <div class="d-flex flex-column gap-3">
                    <section class="panel" aria-label="Controle de vacinas">
                        <div class="panel-h">
                            <i class="bi bi-droplet text-warning"></i>
                            <h2>Controle de vacinas</h2>
                        </div>
                        <div class="p-2 pb-0">
                            <ul class="nav nav-pills" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <a href="#tab-vencidas" class="nav-link active" data-bs-toggle="tab" role="tab">
                                        <i class="bi bi-exclamation-triangle me-1"></i>Vencidas <span class="badge text-bg-danger">{{ vacinas_vencidas|length }}</span>
                                    </a>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <a href="#tab-programadas" class="nav-link" data-bs-toggle="tab" role="tab">
                                        <i class="bi bi-calendar-check me-1"></i>Programadas <span class="badge text-bg-info">{{ vacinas_programadas|length }}</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <div class="tab-content scroll">
                            {% for aba, lista in {'vencidas': vacinas_vencidas, 'programadas': vacinas_programadas} %}
                                <div class="tab-pane fade {{ aba == 'vencidas' ? 'show active' : '' }}" id="tab-{{ aba }}" role="tabpanel">
                                    {% for vacina in lista %}
                                        {% set petId   = attribute(vacina, 'pet_id')|default(attribute(vacina, 'id')) %}
                                        {% set petNome = attribute(vacina, 'pet_nome')|default(attribute(vacina, 'nome_pet')|default('Pet')) %}
                                        {% set tipo    = attribute(vacina, 'tipo')|default('') %}
                                        {% set dtVal   = attribute(vacina, 'data_validade')|default(null) %}
                                        <div class="row-item">
                                            <span class="ico {{ aba == 'vencidas' ? 'text-danger' : 'text-info' }}">
                                                <i class="bi {{ aba == 'vencidas' ? 'bi-exclamation-triangle' : 'bi-calendar-check' }}"></i>
                                            </span>
                                            <div class="me-auto min-w-0">
                                                {% if petId is not null %}<a class="nome consulta" href="{{ path('clinica_detalhes_pet', {'id': petId}) }}">{{ petNome }}</a>{% else %}<span class="nome">{{ petNome }}</span>{% endif %}
                                                <small class="text-secondary">{{ tipo }}</small>
                                            </div>
                                            <span class="badge {{ aba == 'vencidas' ? 'text-bg-danger' : 'text-bg-info' }}">{{ dtVal ? dtVal|date('d/m/Y') : '' }}</span>
                                        </div>
                                    {% else %}
                                        <div class="empty">
                                            <i class="bi {{ aba == 'vencidas' ? 'bi-check-circle text-success' : 'bi-inbox' }}"></i>{{ aba == 'vencidas' ? 'Nenhuma vacina vencida.' : 'Nenhuma vacina programada.' }}</div>
                                    {% endfor %}
                                </div>
                            {% endfor %}
                        </div>
                    </section>
                    <section class="panel" aria-label="Últimos animais cadastrados">
                        <div class="panel-h">
                            <i class="bi bi-postcard-heart text-primary"></i>
                            <h2>Últimos animais cadastrados</h2>
                        </div>
                        <div class="scroll">
                            {% for animal in animais_cadastrados %}
                                <div class="row-item">
                                    <span class="ico">
                                        <i class="bi bi-postcard-heart"></i>
                                    </span>
                                    <div class="min-w-0">
                                        <a class="nome consulta" href="{{ path('clinica_detalhes_pet', {'id': animal.id}) }}">{{ animal.nome }}</a>
                                        <small class="text-secondary">{{ animal.tutor }}</small>
                                    </div>
                                </div>
                            {% else %}
                                <div class="empty">
                                    <i class="bi bi-inbox"></i>Nenhum animal cadastrado.</div>
                            {% endfor %}
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
    <!-- 🔹 OFFCANVAS - PRESCRIÇÕES MÉDICAS -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasPrescricoes" style="width: 90%; max-width: 1400px;">
        <div class="offcanvas-header text-white" style="background: linear-gradient(135deg, #14B8A6 0%, #14B8A6 100%);">
            <h5 class="offcanvas-title">
            <i class="bi bi-calendar-event me-2"></i>Calendário de Prescrições Médicas
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas">
            </button>
        </div>
        <div class="offcanvas-body">
            <p class="text-muted mb-4">
                <i class="bi bi-info-circle me-2"></i>
                Visualize e gerencie todas as prescrições de todos os pets internados
            </p>
            <div id="calendar-prescricoes-geral"
                style="width: 100%; min-height: 700px; background: white; border-radius: 8px; padding: 10px;">
            </div>
        </div>
    </div>
{% endblock %}
{% block javascripts %}
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.js'>
    </script>
    <script src='https://cdn.jsdelivr.net/npm/@fullcalendar/core@6.1.19/locales-all.global.min.js'>
    </script>
    <script>
        $(function() {
        $('#searchForm').attr('action', "{{ path('clinica_dashboard') }}");
        var largura = screen.width;
        var altura = screen.height;
        $('.consulta').on('click', function() {
            var pagina = $(this).attr('href');
            window.open(pagina, "", "location=center,toolbar=no,scrollbars=yes,status=no,dialog=yes,resizable=no,minimaze=no,fullscreen=no,width=" + largura + ",height=" + altura + ",top=100,left=200");
            return false;
        });
        // 🔹 CALENDÁRIO DE PRESCRIÇÕES GERAL - Carrega quando abrir o offcanvas
        let calendarLoaded = false;
        let calendar = null;
        console.log('🔍 Iniciando script do calendário...');
        const offcanvasPrescricoes = document.getElementById('offcanvasPrescricoes');
        console.log('🔍 Offcanvas encontrado:', offcanvasPrescricoes ? 'SIM' : 'NÃO');
        if (offcanvasPrescricoes) {
            offcanvasPrescricoes.addEventListener('shown.bs.offcanvas', function() {
                console.log('✅ Offcanvas aberto!');
                if (!calendarLoaded) {
                    const calendarEl = document.getElementById('calendar-prescricoes-geral');
                    console.log('🔍 Elemento calendário encontrado:', calendarEl ? 'SIM' : 'NÃO');
                    if (calendarEl) {
                        const eventos = {
                            {
                                calendario_prescricoes_geral | json_encode | raw
                            }
                        };
                        console.log('📊 Total de eventos:', eventos.length);
                        console.log('📋 Eventos:', eventos);
                        if (typeof FullCalendar === 'undefined') {
                            console.error('❌ FullCalendar não está carregado!');
                            calendarEl.innerHTML = '<div class="alert alert-danger">Erro: FullCalendar não carregado. Recarregue a página.</div>';
                            return;
                        }
                        console.log('✅ FullCalendar está disponível!');
                        try {
                            calendar = new FullCalendar.Calendar(calendarEl, {
                                initialView: 'timeGridWeek',
                                locale: 'pt-br',
                                height: 700,
                                slotMinTime: "00:00:00",
                                slotMaxTime: "24:00:00",
                                allDaySlot: false,
                                headerToolbar: {
                                    left: 'prev,next today',
                                    center: 'title',
                                    right: 'timeGridDay,timeGridWeek,dayGridMonth'
                                },
                                events: eventos,
                                eventClick: function(info) {
                                    const event = info.event;
                                    const petNome = event.extendedProps.pet_nome || 'Pet';
                                    const donoNome = event.extendedProps.dono_nome || '';
                                    const internacaoId = event.extendedProps.internacao_id;
                                    const eventoId = event.extendedProps.evento_id;
                                    const status = event.extendedProps.status || 'pendente';
                                    const descricao = event.extendedProps.descricao || '';
                                    let statusBadge = status === 'confirmado' ?
                                        '<span class="badge bg-success">Administrado</span>' :
                                        '<span class="badge bg-warning">Pendente</span>';
                                    let botaoConfirmar = '';
                                    if (status !== 'confirmado') {
                                        botaoConfirmar = `
        <button class="btn btn-success w-100 mb-2" onclick="confirmarMedicamentoGeral(${eventoId}, ${internacaoId}, '${event.title.replace(/'/g, "\\'")}')">
        <i class="bi bi-check-lg me-1"></i>Confirmar Administração
        </button>
        `;
                                    }
                                    const modalHtml = `
        <div class="modal fade" id="modalDetalhePrescricao" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">Detalhes da Prescrição</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal">
                        </button>
                    </div>
                    <div class="modal-body">
                        <h5 class="mb-3">${event.title}</h5>
                        <p class="mb-2">
                        <strong>Pet:</strong> ${petNome}</p>
                        <p class="mb-2">
                        <strong>Tutor:</strong> ${donoNome}</p>
                        <p class="mb-2">
                        <strong>Horário:</strong> ${event.start.toLocaleString('pt-BR')}</p>
                        ${descricao ? `<p class="mb-2">
                        <strong>Detalhes:</strong> ${descricao}</p>` : ''}
                        <p class="mb-3">
                        <strong>Status:</strong> ${statusBadge}</p>
                        ${botaoConfirmar}
                        <a href="internacao/${internacaoId}/ficha"
                            class="btn btn-primary w-100" target="_blank">
                            <i class="fas fa-external-link-alt me-1"></i>Abrir Ficha de Internação
                        </a>
                    </div>
                </div>
            </div>
        </div>
        `;
                                    // Remove modal anterior se existir
                                    const oldModal = document.getElementById('modalDetalhePrescricao');
                                    if (oldModal) oldModal.remove();
                                    // Adiciona novo modal
                                    document.body.insertAdjacentHTML('beforeend', modalHtml);
                                    // Abre o modal
                                    const modal = new bootstrap.Modal(document.getElementById('modalDetalhePrescricao'));
                                    modal.show();
                                    // Remove modal do DOM quando fechar
                                    document.getElementById('modalDetalhePrescricao').addEventListener('hidden.bs.modal', function() {
                                        this.remove();
                                    });
                                }
                            });
                            console.log('Renderizando calendário...');
                            calendar.render();
                            calendarLoaded = true;
                            console.log('Calendário renderizado com sucesso!');
                        } catch (error) {
                            console.error('Erro ao criar calendário:', error);
                            calendarEl.innerHTML = '<div class="alert alert-danger">Erro ao carregar calendário: ' + error.message + '</div>';
                        }
                    } else {
                        console.error('Elemento calendar-prescricoes-geral não encontrado!');
                    }
                } else {
                    console.log('Calendário já foi carregado');
                }
            });
        } else {
            console.error('Elemento offcanvasPrescricoes não encontrado!');
        }
    });
    // 🔹 Função para confirmar administração de medicamento no calendário geral
    function confirmarMedicamentoGeral(eventoId, internacaoId, titulo) {
        if (!confirm(`Confirmar administração de:\n${titulo}?`)) {
            return;
        }
        // Fecha o modal antes de processar
        const modalElement = document.getElementById('modalDetalhePrescricao');
        if (modalElement) {
            const modal = bootstrap.Modal.getInstance(modalElement);
            if (modal) modal.hide();
        }
        const horaAplicacao = new Date().toISOString().slice(0, 16);
        // Cria FormData para enviar
        const formData = new FormData();
        formData.append('hora_aplicacao', horaAplicacao);
        formData.append('veterinario_id', 1); // ID padrão
        formData.append('anotacoes', 'Confirmado via calendário geral');
        console.log('🔄 Confirmando medicamento...', {
            eventoId,
            internacaoId
        });
        fetch(`/homepet/public/clinica/internacao/${internacaoId}/evento/${eventoId}/executar`, {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                console.log('✅ Resposta do servidor:', data);
                if (data.ok || data.success) {
                    alert('✅ Medicamento confirmado com sucesso!');
                    // Recarrega a página para atualizar as cores
                    window.location.reload();
                } else {
                    alert('❌ Erro ao confirmar: ' + (data.msg || data.message || 'Erro desconhecido'));
                }
            })
            .catch(error => {
                console.error('❌ Erro:', error);
                alert('❌ Erro ao confirmar medicamento: ' + error.message);
            });
    }
    // 🔍 SISTEMA DE BUSCA
    const searchInput = document.getElementById('searchInput');
    const searchResults = document.getElementById('searchResults');
    const searchForm = document.getElementById('searchForm');
    let searchTimeout;
    searchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        const query = this.value.trim();
        if (query.length < 2) {
            searchResults.style.display = 'none';
            return;
        }
        searchTimeout = setTimeout(async () => {
            try {
                const response = await fetch(`/homepet/public/clinica/buscar?q=${encodeURIComponent(query)}`);
                const data = await response.json();
                if (data.resultados && data.resultados.length > 0) {
                    searchResults.innerHTML = data.resultados.map(r => `
        <a href="${r.url}" class="search-result-item">
            <i class="bi ${r.icon} me-2"></i>
            <div>
                <strong>${r.nome}</strong>
                <small class="text-muted d-block">${r.tipo}</small>
            </div>
        </a>
        `).join('');
                    searchResults.style.display = 'block';
                } else {
                    searchResults.innerHTML = '<div class="search-result-item text-muted">Nenhum resultado encontrado</div>';
                    searchResults.style.display = 'block';
                }
            } catch (error) {
                console.error('Erro na busca:', error);
            }
        }, 300);
    });
    </script>
{% endblock %}