{% extends app.request.query.get('ficha')
    ? 'baseClinica.html.twig'
    : 'base.html.twig'
%}
{% block title %}Relatório de Vendas{% endblock %}

{% block body %}
    {% if app.request.query.get('ficha') is not defined %}
    <div class="pagetitle">
        <h1>Relatório de Vendas
            <a class="me-md-5 mt-sm-3 btn btn-primary btm-sm mb-3 float-md-end"
               href="{{ url('clinica_pdv_index') }}">
                <i class="bi bi-arrow-left me-1"></i>Voltar
            </a>
        </h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ url('home') }}">Home</a></li>
                <li class="breadcrumb-item">Atendimento</li>
                <li class="breadcrumb-item">PDV</li>
                <li class="breadcrumb-item active">Relatório de Vendas</li>
            </ol>
        </nav>
    </div>
{% endif %}

    {# Flash messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="container-fluid bg-white p-4 mt-4 rounded shadow-sm">

        <!-- 🔹 Barra de navegação -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a href="{{ path('clinica_pdv_index') }}" class="btn btn-outline-primary me-2">
                    <i class="bi bi-cash-coin"></i> PDV
                </a>
                <a href="{{ path('clinica_pdv_caixa') }}" class="btn btn-outline-success">
                    <i class="bi bi-wallet2"></i> Fechamento de Caixa
                </a>
            </div>
        </div>
        <hr>

        {# Barra de seleção: aparece quando há vendas marcadas #}
        <div id="barraSelecao" class="alert alert-primary d-none align-items-center justify-content-between flex-wrap gap-2 shadow-sm"
             style="position: sticky; top: 0; z-index: 10;" role="status">
            <div>
                <i class="bi bi-check2-square me-1"></i>
                <strong id="selQtd">0</strong> venda(s) selecionada(s) —
                <span id="selCliente" class="fw-semibold"></span>
                <span class="mx-1">•</span>
                Total: <strong id="selTotal">R$ 0,00</strong>
            </div>
            <div class="d-flex gap-2">
                <button type="button" id="btnLimparSelecao" class="btn btn-outline-secondary btn-sm">Limpar</button>
                <button type="button" id="btnLancarSelecionadas" class="btn btn-success btn-sm">
                    <i class="bi bi-cash-stack me-1"></i>Lançar selecionadas no Caixa
                </button>
            </div>
        </div>
        <div id="avisoSelecao" class="alert alert-warning py-2 d-none" role="alert"></div>

        <table id="tabelaVendas" class="table table-striped table-hover align-middle">
            <thead class="table-light">
            <tr>
                <th class="text-center" style="width:40px" title="Selecionar para lançar várias vendas juntas no caixa"><i class="bi bi-check2-square"></i></th>
                <th>#ID</th>
                <th>Data</th>
                <th>Cliente</th>
                <th>Pet</th>
                <th>Valor</th>
                <th>Forma de Pagamento</th>
                <th>Status</th>
                <th class="text-center">Ações</th>
            </tr>
            </thead>
            <tbody>
            {% for v in vendas %}
                <tr>
                    <td class="text-center">
                        {% if v.status in ['Aberta', 'Pendente'] %}
                            <input type="checkbox" class="form-check-input chk-venda"
                                   value="{{ v.id }}"
                                   data-total="{{ v.total }}"
                                   data-grupo="{{ (v.petId ?: '0') ~ '|' ~ (v.cliente|lower|trim) }}"
                                   data-cliente="{{ v.cliente }}"
                                   data-pet="{{ v.petNome ?: '—' }}"
                                   aria-label="Selecionar venda {{ v.id }}">
                        {% endif %}
                    </td>
                    <td>{{ v.id }}</td>
                    <td>{{ v.data|date('d/m/Y H:i') }}</td>
                    <td>{{ v.cliente }}</td>
                    <td>{{ v.petNome ?: '—' }}</td>
                    <td>R$ {{ v.total|number_format(2, ',', '.') }}</td>
                    <td>{{ v.metodoPagamento|upper }}</td>
                    <td>
                        {# Badge colorido por status #}
                        {% if v.status in ['aberto', 'Carrinho', 'carrinho'] %}
                            <span class="badge bg-warning text-dark">{{ v.status|capitalize }}</span>
                        {% elseif v.status in ['finalizado', 'Finalizado'] %}
                            <span class="badge bg-success">Finalizado</span>
                        {% elseif v.status in ['cancelado', 'Cancelado', 'inativo'] %}
                            <span class="badge bg-danger">{{ v.status|capitalize }}</span>
                        {% else %}
                            <span class="badge bg-secondary">{{ v.status }}</span>
                        {% endif %}
                    </td>
                    <td class="text-center">
                        {# ✅ Botão "Lançar no Caixa" — apenas para vendas abertas/carrinho #}
                        {% if v.status in ['Aberta', 'Carrinho', 'carrinho', 'Pendente'] %}
                            <a href="{{ path('pdv_carregar', {id: v.id}) }}"
                               class="btn btn-success btn-sm"
                               title="Lançar esta venda no PDV para finalização">
                                <i class="bi bi-cash-stack me-1"></i>Lançar no Caixa
                            </a>
                        {% else %}
                            <span class="text-muted small">—</span>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                        Nenhuma venda encontrada.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if vendas is not empty %}
    <script>
        $(document).ready(function () {
            if ($.fn.DataTable && $('#tabelaVendas').length) {
                $('#tabelaVendas').DataTable({
                    language: {
                        url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/pt-BR.json'
                    },
                    // Mantém a ordem vinda do servidor (mais recentes primeiro)
                    order: [],
                    pageLength: 25,
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, 'Todos']],
                    responsive: true,
                    // Coluna "Ações" não entra na ordenação nem na busca
                    columnDefs: [
                        { orderable: false, searchable: false, targets: [0, -1] }
                    ]
                });
            }

            // ==================== SELEÇÃO DE VÁRIAS VENDAS ====================
            // A seleção fica guardada aqui (e não no DOM) para sobreviver à
            // paginação e à busca do DataTables.
            var selecionadas = {};   // id => { centavos, grupo, cliente, pet }
            var urlLote = '{{ path("pdv_carregar_lote") }}';
            var ficha = {{ app.request.query.get('ficha') ? 'true' : 'false' }};

            function formatarReais(centavos) {
                return 'R$ ' + (centavos / 100).toLocaleString('pt-BR', {
                    minimumFractionDigits: 2, maximumFractionDigits: 2
                });
            }

            function grupoAtual() {
                var ids = Object.keys(selecionadas);
                return ids.length ? selecionadas[ids[0]].grupo : null;
            }

            function avisar(msg) {
                var $a = $('#avisoSelecao');
                if (!msg) { $a.addClass('d-none').text(''); return; }
                $a.removeClass('d-none').text(msg);
                clearTimeout(avisar._t);
                avisar._t = setTimeout(function () { $a.addClass('d-none'); }, 6000);
            }

            function atualizarBarra() {
                var ids = Object.keys(selecionadas);
                var total = 0;
                ids.forEach(function (id) { total += selecionadas[id].centavos; });

                $('#selQtd').text(ids.length);
                $('#selTotal').text(formatarReais(total));

                if (ids.length) {
                    var ref = selecionadas[ids[0]];
                    $('#selCliente').text(ref.cliente + (ref.pet !== '—' ? ' / ' + ref.pet : ''));
                    $('#barraSelecao').removeClass('d-none').addClass('d-flex');
                } else {
                    $('#barraSelecao').addClass('d-none').removeClass('d-flex');
                }
            }

            // Ao trocar de página/filtrar, remarca os checkboxes que estavam selecionados
            function remarcarVisiveis() {
                $('#tabelaVendas .chk-venda').each(function () {
                    $(this).prop('checked', !!selecionadas[this.value]);
                });
            }
            $('#tabelaVendas').on('draw.dt', remarcarVisiveis);

            $('#tabelaVendas').on('change', '.chk-venda', function () {
                var $chk = $(this);
                var id = this.value;

                if (!this.checked) {
                    delete selecionadas[id];
                    atualizarBarra();
                    return;
                }

                // Só agrupa vendas do mesmo cliente e do mesmo pet
                var grupo = grupoAtual();
                if (grupo !== null && grupo !== $chk.data('grupo')) {
                    this.checked = false;
                    avisar('Só é possível selecionar vendas do mesmo cliente e do mesmo pet. Limpe a seleção para escolher outro.');
                    return;
                }

                selecionadas[id] = {
                    centavos: Math.round(parseFloat($chk.data('total')) * 100) || 0,
                    grupo: $chk.data('grupo'),
                    cliente: String($chk.data('cliente')),
                    pet: String($chk.data('pet'))
                };
                avisar('');
                atualizarBarra();
            });

            $('#btnLimparSelecao').on('click', function () {
                selecionadas = {};
                remarcarVisiveis();
                atualizarBarra();
            });

            $('#btnLancarSelecionadas').on('click', function () {
                var ids = Object.keys(selecionadas);
                if (!ids.length) { return; }
                var url = urlLote + '?ids=' + ids.join(',') + (ficha ? '&ficha=1' : '');
                window.location.href = url;
            });
        });
    </script>
    {% endif %}
{% endblock %}
