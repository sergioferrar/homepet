            const toolbar = [
                ['bold', 'italic', 'underline', 'strike'],
                [{'align': []}],
                [{'list': 'ordered'}, {'list': 'bullet'}],
                ['link', 'clean']
            ];

            const quillCabecalho = new Quill('#editor-cabecalho', {theme: 'snow', modules: {toolbar}});
            const quillConteudo = new Quill('#editor-conteudo', {theme: 'snow', modules: {toolbar}});
            const quillRodape = new Quill('#editor-rodape', {theme: 'snow', modules: {toolbar}});

            const formDoc = document.getElementById('form-documento');
            const formPdf = document.getElementById('form-pdf');
            const btnPdf = document.getElementById('btn-pdf');
            const selectTermo = document.getElementById('select-termo');
            const inputTitulo = document.getElementById('titulo');
            const inputTipo = document.getElementById('tipo');

            // Carregar termo pré-definido selecionado
            selectTermo.addEventListener('change', function () {
                if (this.value) {
                    carregarTermo(this.value);
                }
            });

            function decodeHtml(html) {
                const txt = document.createElement("textarea");
                txt.innerHTML = html;
                return txt.value;
            }

            // Salvar no banco
            formDoc.addEventListener('submit', function () {
                document.getElementById('input-cabecalho').value = quillCabecalho.root.innerHTML;
                document.getElementById('input-conteudo').value = quillConteudo.root.innerHTML;
                document.getElementById('input-rodape').value = quillRodape.root.innerHTML;
            });

            // Gerar PDF
            btnPdf.addEventListener('click', function () {
                // Salva na sessão via AJAX e depois abre PDF
                const dados = {
                    cabecalho: quillCabecalho.root.innerHTML,
                    conteudo: quillConteudo.root.innerHTML,
                    rodape: quillRodape.root.innerHTML,
                    tipo_documento: inputTipo.value || 'DOCUMENTO'
                };
                
                // Salva os dados na sessão via AJAX
                fetch('{{ path('clinica_documentos', {'petId': pet.id}) }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: 'salvar_pdf_sessao=1&dados=' + encodeURIComponent(JSON.stringify(dados))
                }).then(response => {
                    if (response.ok) {
                        // Abre o PDF em nova aba
                        window.open('{{ path('clinica_documento_pdf', {'petId': pet.id}) }}', '_blank');
                    }
                });
            });

