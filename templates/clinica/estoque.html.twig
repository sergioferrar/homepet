{% block javascripts %}
<script>
$(function () {
    // ========== MODAL NOVO PRODUTO ==========
    $('.novoProd').on('click', function () {
        var $modal = $('#novoProduto');
        var $conteudoForm = $('.formProd').clone().removeClass('d-none');
        
        $modal.find('.modal-body').html($conteudoForm.html());
        
        var modalInstance = new bootstrap.Modal($modal[0]);
        modalInstance.show();
        
        $modal.one('shown.bs.modal', function () {
            $modal.find('[data-bs-toggle="tab"]').each(function() {
                $(this).off('click').on('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    $modal.find('.nav-link').removeClass('active');
                    $modal.find('.tab-pane').removeClass('show active');
                    
                    $(this).addClass('active');
                    var target = $(this).data('bs-target');
                    $modal.find(target).addClass('show active');
                });
            });
        });
        
        return false;
    });

    // ========== MODAL GERENCIAR ESTOQUE ==========
    $('.btn-gerenciar-estoque').on('click', function() {
        var produtoId = $(this).data('produto-id');
        var produtoNome = $(this).data('produto-nome');
        
        var $modal = $('#modalEstoque');
        var modalInstance = new bootstrap.Modal($modal[0]);
        
        $('.produto-nome-modal').text(produtoNome);
        
        carregarDadosEstoque(produtoId);
        
        modalInstance.show();
        
        var now = new Date();
        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
        $('#data-movimento').val(now.toISOString().slice(0, 16));
    });

    function carregarDadosEstoque(produtoId) {
        // Dados mockados para demonstração
        var mockData = {
            id: 1,
            produtoId: produtoId,
            quantidade_atual: 50,
            quantidade_reserva: 5,
            quantidade_disponivel: 45,
            estoque_minimo: 10,
            etoque_maximo: 100,
            custo_medio: 15.50,
            custo_ultima_compra: 16.00,
            refrigerado: 0,
            controla_lote: 1,
            controla_validade: 1,
            status: 'ativo'
        };
        
        preencherDadosEstoque(mockData);
    }

    function preencherDadosEstoque(data) {
        $('#qtd-atual').text(data.quantidade_atual || 0);
        $('#qtd-reserva').text(data.quantidade_reserva || 0);
        $('#qtd-disponivel').text(data.quantidade_disponivel || 0);
        $('#estoque-minimo').text(data.estoque_minimo || 0);
        $('#estoque-maximo').text(data.etoque_maximo || 0);
        $('#custo-medio').text('R$ ' + (data.custo_medio || 0).toFixed(2).replace('.', ','));
        $('#custo-ultima').text('R$ ' + (data.custo_ultima_compra || 0).toFixed(2).replace('.', ','));
        
        $('#refrigerado').text(data.refrigerado ? 'Sim' : 'Não')
            .removeClass('bg-secondary bg-success').addClass(data.refrigerado ? 'bg-success' : 'bg-secondary');
        $('#controla-lote').text(data.controla_lote ? 'Sim' : 'Não')
            .removeClass('bg-secondary bg-success').addClass(data.controla_lote ? 'bg-success' : 'bg-secondary');
        $('#controla-validade').text(data.controla_validade ? 'Sim' : 'Não')
            .removeClass('bg-secondary bg-success').addClass(data.controla_validade ? 'bg-success' : 'bg-secondary');
        
        var statusClass = data.status === 'ativo' ? 'bg-success' : (data.status === 'suspenso' ? 'bg-warning' : 'bg-danger');
        $('#status-estoque').text(data.status ? data.status.charAt(0).toUpperCase() + data.status.slice(1) : 'Ativo')
            .removeClass('bg-success bg-warning bg-danger').addClass(statusClass);
        
        if (data.quantidade_atual < data.estoque_minimo) {
            $('#alerta-estoque-baixo').removeClass('d-none');
        } else {
            $('#alerta-estoque-baixo').addClass('d-none');
        }
        
        $('#edit-estoque-id').val(data.id);
        $('#edit-produto-id').val(data.produtoId);
        $('#edit-qtd-atual').val(data.quantidade_atual);
        $('#edit-estoque-minimo').val(data.estoque_minimo);
        $('#edit-estoque-maximo').val(data.etoque_maximo);
        $('#edit-custo-medio').val(data.custo_medio);
        $('#edit-custo-ultima').val(data.custo_ultima_compra);
        $('#edit-status').val(data.status || 'ativo');
        $('#edit-refrigerado').prop('checked', data.refrigerado == 1);
        $('#edit-controla-lote').prop('checked', data.controla_lote == 1);
        $('#edit-controla-validade').prop('checked', data.controla_validade == 1);
        
        $('#mov-produto-id').val(data.produtoId);
        $('#info-qtd-atual').text(data.quantidade_atual || 0);
        
        carregarHistorico(data.produtoId);
    }

    function carregarHistorico(produtoId) {
        // Mock de histórico
        var mockHistorico = [
            { data: '02/02/2026 10:30', tipo: 'entrada', quantidade: 20, custo: 15.50, saldo: 50, observacao: 'Compra fornecedor X' },
            { data: '01/02/2026 14:15', tipo: 'saida', quantidade: 5, custo: 0, saldo: 30, observacao: 'Venda PDV' }
        ];
        
        if (mockHistorico.length > 0) {
            var html = '';
            mockHistorico.forEach(function(mov) {
                var tipoClass = mov.tipo === 'entrada' ? 'success' : 'danger';
                var tipoIcon = mov.tipo === 'entrada' ? 'arrow-down-circle' : 'arrow-up-circle';
                var sinal = mov.tipo === 'entrada' ? '+' : '-';
                
                html += '<tr>';
                html += '<td><i class="bi bi-calendar3 me-1"></i>' + mov.data + '</td>';
                html += '<td><span class="badge bg-' + tipoClass + '"><i class="bi bi-' + tipoIcon + ' me-1"></i>' + mov.tipo.toUpperCase() + '</span></td>';
                html += '<td class="text-' + tipoClass + ' fw-bold">' + sinal + mov.quantidade + '</td>';
                html += '<td>R$ ' + (mov.custo || 0).toFixed(2).replace('.', ',') + '</td>';
                html += '<td><span class="badge bg-primary">' + mov.saldo + '</span></td>';
                html += '<td><small class="text-muted">' + (mov.observacao || '-') + '</small></td>';
                html += '</tr>';
            });
            $('#tabela-historico').html(html);
        } else {
            $('#tabela-historico').html('<tr><td colspan="6" class="text-center py-4 text-muted"><i class="bi bi-inbox fs-3 d-block mb-2"></i>Nenhum movimento registrado</td></tr>');
        }
    }

    $('#formEditarEstoque').on('submit', function(e) {
        e.preventDefault();
        alert('Funcionalidade de atualização será implementada no backend');
    });

    $('#formLancarMovimento').on('submit', function(e) {
        e.preventDefault();

        var produtoId = $('#mov-produto-id').val();
        var tipo = $('#tipo-movimento').val();
        var quantidade = parseInt($('#qtd-movimento').val(), 10);
        var observacao = ($('#obs-movimento').val() || '').trim();

        if (!produtoId) { alert('Produto não identificado.'); return; }
        if (!tipo) { alert('Selecione o tipo de movimento.'); return; }
        if (!quantidade || quantidade <= 0) { alert('Informe uma quantidade válida.'); return; }

        // Roteia para o endpoint correto conforme o tipo de movimento
        var url, dados = { produto_id: produtoId, observacao: observacao };

        if (tipo === 'entrada' || tipo === 'devolucao') {
            url = "{{ path('clinica_estoque_entrada') }}";
            dados.quantidade = quantidade;
            if (tipo === 'devolucao') {
                dados.observacao = ('Devolução' + (observacao ? ' - ' + observacao : ''));
            }
        } else if (tipo === 'saida') {
            url = "{{ path('clinica_estoque_saida') }}";
            dados.quantidade = quantidade;
        } else if (tipo === 'ajuste') {
            // No ajuste de inventário, a quantidade informada é o novo saldo absoluto
            url = "{{ path('clinica_estoque_ajustar') }}";
            dados.estoque = quantidade;
        } else {
            alert('Tipo de movimento inválido.');
            return;
        }

        var $btn = $(this).find('button[type="submit"]');
        var htmlOriginal = $btn.html();
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Lançando...');

        $.ajax({
            url: url,
            method: 'POST',
            data: dados,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        }).done(function (resp) {
            if (resp && resp.success) {
                location.reload();
            } else {
                alert((resp && resp.message) ? resp.message : 'Não foi possível lançar o movimento.');
                $btn.prop('disabled', false).html(htmlOriginal);
            }
        }).fail(function (xhr) {
            var msg = 'Erro ao lançar o movimento.';
            try { msg = JSON.parse(xhr.responseText).message || msg; } catch (e) {}
            alert(msg);
            $btn.prop('disabled', false).html(htmlOriginal);
        });
    });

    // ========== SEPARAÇÃO DE ESTOQUE (LOJA x INTERNO) ==========

    // Alterar o tipo de estoque de um produto (loja / interno / ambos)
    $('.select-tipo-estoque').on('change', function () {
        var $select = $(this);
        var produtoId = $select.data('produto-id');
        var tipo = $select.val();
        var valorAnterior = $select.data('anterior') || 'loja';

        $select.prop('disabled', true);

        $.ajax({
            url: "{{ path('clinica_estoque_tipo') }}",
            method: 'POST',
            data: { produto_id: produtoId, tipo_estoque: tipo },
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        }).done(function (resp) {
            if (resp && resp.success) {
                // Recarrega para refletir o produto na(s) aba(s) correta(s)
                location.reload();
            } else {
                alert((resp && resp.message) ? resp.message : 'Não foi possível alterar o tipo de estoque.');
                $select.val(valorAnterior).prop('disabled', false);
            }
        }).fail(function () {
            alert('Erro de comunicação ao alterar o tipo de estoque.');
            $select.val(valorAnterior).prop('disabled', false);
        });
    });
    // Guarda o valor atual para poder reverter em caso de erro
    $('.select-tipo-estoque').each(function () {
        $(this).data('anterior', $(this).val());
    }).on('focus', function () {
        $(this).data('anterior', $(this).val());
    });

    // Registrar uso interno (baixa de estoque)
    $('.btn-usar-interno').on('click', function () {
        var $btn = $(this);
        var produtoId = $btn.data('produto-id');
        var produtoNome = $btn.data('produto-nome');
        var qtd = parseInt($('.input-qtd-interno[data-produto-id="' + produtoId + '"]').val(), 10);
        var obs = $('.input-obs-interno[data-produto-id="' + produtoId + '"]').val() || '';

        if (!qtd || qtd <= 0) {
            alert('Informe a quantidade a usar de "' + produtoNome + '".');
            return;
        }

        if (!confirm('Registrar uso de ' + qtd + ' unidade(s) de "' + produtoNome + '"? A quantidade será baixada do estoque.')) {
            return;
        }

        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

        $.ajax({
            url: "{{ path('clinica_estoque_uso_interno') }}",
            method: 'POST',
            data: { produto_id: produtoId, quantidade: qtd, observacao: obs },
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        }).done(function (resp) {
            if (resp && resp.success) {
                var $badge = $('#estoque-interno-' + produtoId);
                $badge.text(resp.estoque_atual);
                if (resp.estoque_atual <= 0) {
                    $badge.removeClass('bg-primary').addClass('bg-danger');
                }
                $('.input-qtd-interno[data-produto-id="' + produtoId + '"]')
                    .val('').attr('max', resp.estoque_atual);
                $('.input-obs-interno[data-produto-id="' + produtoId + '"]').val('');
            } else {
                alert((resp && resp.message) ? resp.message : 'Não foi possível registrar o uso interno.');
            }
        }).fail(function (xhr) {
            var msg = 'Erro ao registrar o uso interno.';
            try { msg = JSON.parse(xhr.responseText).message || msg; } catch (e) {}
            alert(msg);
        }).always(function () {
            $btn.prop('disabled', false).html('<i class="bi bi-check2-circle me-1"></i> Aplicar');
        });
    });

    // Busca dentro da planilha de uso interno
    $('#buscaInterno').on('keyup', function () {
        var termo = $(this).val().toLowerCase().trim();
        $('#tabelaInterno tbody tr.linha-interno').each(function () {
            var nome = ($(this).data('nome') || '').toString();
            $(this).toggle(nome.indexOf(termo) !== -1);
        });
    });

    // Imprimir a planilha de uso interno — imprime SOMENTE a tabela,
    // isolando o conteúdo em um iframe temporário (não imprime a página inteira).
    $('#btnImprimirPlanilha').on('click', function () {
        var conteudo = document.getElementById('planilhaInternaPrint').innerHTML;

        var estilos =
            '<style>' +
            '* { box-sizing: border-box; }' +
            'body { font-family: "DejaVu Sans", Arial, Helvetica, sans-serif; color: #000; margin: 0; padding: 20px; }' +
            '.receita-container { padding: 24px; border: 1px solid #ccc; border-radius: 12px; }' +
            '.cabecalho { text-align: center; margin-bottom: 24px; }' +
            '.cabecalho h4 { font-size: 20px; margin: 0 0 4px; }' +
            '.cabecalho h5.titulo-doc { font-size: 15px; margin: 8px 0 6px; font-weight: bold; }' +
            '.cabecalho .endereco { font-size: 11px; color: #333; margin: 0; }' +
            '.cabecalho .linha-data { font-size: 12px; margin: 6px 0 0; }' +
            '.cabecalho hr { border: 0; border-top: 1px solid #999; margin: 14px 0; }' +
            '.conteudo { margin: 16px 0 28px; }' +
            '.tabela-print { width: 100%; border-collapse: collapse; font-size: 12px; }' +
            '.tabela-print th, .tabela-print td { border: 1px solid #333; padding: 6px 8px; text-align: left; height: 30px; }' +
            '.tabela-print th { background: #eee; }' +
            '.tabela-print .tc { text-align: center; }' +
            '.tabela-print small { color: #555; }' +
            '.rodape { text-align: center; margin-top: 40px; }' +
            '.rodape p { margin: 0; font-size: 12px; }' +
            '.rodape .assinatura { font-size: 11px; color: #333; }' +
            '@page { size: A4 landscape; margin: 12mm; }' +
            '</style>';

        var iframe = document.createElement('iframe');
        iframe.setAttribute('aria-hidden', 'true');
        iframe.style.position = 'fixed';
        iframe.style.right = '0';
        iframe.style.bottom = '0';
        iframe.style.width = '0';
        iframe.style.height = '0';
        iframe.style.border = '0';
        document.body.appendChild(iframe);

        var doc = iframe.contentWindow.document;
        doc.open();
        doc.write('<!DOCTYPE html><html><head><meta charset="utf-8"><title>Planilha de Uso Interno</title>' +
                  estilos + '</head><body>' + conteudo + '</body></html>');
        doc.close();

        var imprimir = function () {
            iframe.contentWindow.focus();
            iframe.contentWindow.print();
            // Remove o iframe após a impressão
            setTimeout(function () {
                if (iframe && iframe.parentNode) {
                    iframe.parentNode.removeChild(iframe);
                }
            }, 1000);
        };

        // Aguarda o conteúdo do iframe carregar antes de imprimir
        if (iframe.contentWindow.document.readyState === 'complete') {
            setTimeout(imprimir, 150);
        } else {
            iframe.onload = function () { setTimeout(imprimir, 150); };
        }
    });
});
</script>
{% endblock %}